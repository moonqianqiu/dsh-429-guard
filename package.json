{
  "name": "dsh-429-guard",
  "description": "DeepSeek Harness 429 守卫：Web UI 右上角常驻浮窗（关闭态小点 / 开启态盾牌，同一格位，开关不跳位），开启后遇到 429 / 配额不足(insufficient_quota) 错误自动退避重试（默认无限，可设逃生阀上限），避免任务中断。",
  "version": "0.2.9",
  "type": "module",
  "author": "suufon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suufon/dsh-429-guard.git"
  },
  "bugs": {
    "url": "https://github.com/suufon/dsh-429-guard/issues"
  },
  "homepage": "https://github.com/suufon/dsh-429-guard#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "429",
    "retry",
    "rate-limit",
    "quota"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/client.js"
  ],
  "license": "MIT"
}
